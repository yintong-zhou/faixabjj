NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by the user management area (/account/utenti):
# inviting and deleting auth users is impossible with the publishable key.
# No NEXT_PUBLIC_ prefix on purpose — this key bypasses Row Level Security
# and must never reach the browser.
SUPABASE_SECRET_KEY=

# Absolute public URL of the deployment. Used for canonical links, Open
# Graph tags, robots.txt and the sitemap — a relative URL is ignored by
# crawlers. No trailing slash. Example: https://faixabjj.vercel.app
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile. Challenges the two forms a signed-out visitor can
# reach: the login form and the password-reset request.
#
# Only the sitekey lives here. The secret belongs to Supabase, not to this app:
# the challenge is verified by Supabase Auth (Authentication -> Attack
# Protection -> CAPTCHA protection, provider Turnstile), which holds the secret
# and checks the token before it reads a password or sends a reset mail. This
# app draws the widget and forwards the token. A token is redeemed exactly
# once, so it cannot also be verified here.
#
# Create the widget at https://dash.cloudflare.com -> Turnstile, registering
# localhost, 127.0.0.1 and the production domain.
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# Server-only. The one exception to the paragraph above: /join creates the
# account with the service role, not signUp(), so Supabase checks no challenge
# there and the registration verifies the Turnstile token itself
# (utils/turnstile-verify.ts). Without it every registration is refused.
# Same widget as the sitekey above: Cloudflare -> Turnstile -> the widget's
# secret key.
TURNSTILE_SECRET_KEY=

# Server-only. Transactional email through notify-flow (a Cloudflare Worker
# that sends over SMTP): password reset, email-change confirmation, password
# changed, welcome on approval. Supabase sends no email. No NEXT_PUBLIC_
# prefix: the key must never reach the browser. One key per app, created with
# `npm run client:create -- faixabjj --remote` in the notify-flow checkout.
NOTIFY_FLOW_URL=https://notify-flow.jjservice.workers.dev
NOTIFY_FLOW_API_KEY=
NOTIFY_FLOW_APP_NAME=Faixa BJJ

# Server-only. Signs the reset and email-change links this app emails
# (utils/auth-link-token.ts). At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every link already sent.
AUTH_LINK_SECRET=
