NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by the user management area (/account/utenti):
# inviting and deleting auth users is impossible with the publishable key.
# No NEXT_PUBLIC_ prefix on purpose — this key bypasses Row Level Security
# and must never reach the browser.
SUPABASE_SECRET_KEY=

# Absolute public URL of the deployment. Used for canonical links, Open
# Graph tags, robots.txt and the sitemap — a relative URL is ignored by
# crawlers. No trailing slash. Example: https://faixabjj.vercel.app
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile. Protects the two forms a signed-out visitor can reach:
# the login form and the password-reset request. Create the widget at
# https://dash.cloudflare.com → Turnstile, registering localhost, 127.0.0.1 and
# the production domain, then copy the two keys here.
#
# The sitekey is printed in the HTML of every page that draws the widget, so it
# carries NEXT_PUBLIC_. The secret must never — it is what siteverify trusts.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# The frontend hostnames siteverify is allowed to report back, comma separated.
# Per deployment, and this is the check that makes one widget safe for local and
# production at once: a production value must NOT contain localhost or
# 127.0.0.1, or a challenge solved on somebody's laptop would be accepted by the
# live site. Local: localhost,127.0.0.1 — production: faixabjj.vercel.app
TURNSTILE_HOSTNAMES=
